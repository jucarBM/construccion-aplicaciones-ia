# Copiar a .env y completar. El .env nunca se sube: está en .gitignore
# desde el primer commit.

# La clave del proveedor de modelos. Se saca en openrouter.ai, plan gratuito.
OPENROUTER_API_KEY=sk-or-v1-...
MODELO=openai/gpt-4o-mini

# La clave que su propio servicio le exige a quien lo llama. No es la del
# proveedor: son dos cosas distintas y conviene no mezclarlas.
API_KEY=invente-una-clave-larga
